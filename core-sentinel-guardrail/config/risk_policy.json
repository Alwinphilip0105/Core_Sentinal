{
  "thresholds": {
    "low": {
      "warn": 1.0,
      "block": 1.0,
      "action_override": "silent",
      "note": "Low risk never interrupts user — logged only"
    },
    "med": {
      "warn": 0.60,
      "block": 1.0,
      "action_override": "warn_only",
      "note": "Medium risk shows badge/toast, never blocks"
    },
    "high": {
      "warn": 0.45,
      "block": 0.75,
      "note": "High risk shows panel and blocks paste"
    }
  },
  "class_overrides": {
    "NAME": { "max_action": "warn" },
    "LOCATION": { "max_action": "warn" },
    "CONTACT": { "max_action": "warn" },
    "ID": { "max_action": "block" },
    "FINANCIAL": { "max_action": "block" },
    "AUTH": { "max_action": "block" },
    "HEALTH": { "max_action": "block" },
    "OTHER_PII": { "max_action": "warn" },
    "O": { "max_action": "silent" }
