# Copy to ".env" in this folder and fill in values (".env" is gitignored).

# Use Project Settings → API → Project URL (e.g. https://abcd1234.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Optional (preferred for retrain metadata writes):
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional override (defaults to retrain_runs):
GUARDRAIL_RETRAIN_SUPABASE_TABLE=retrain_runs

# Document scan rows (document_scanner.py) → public.document_scans when this table exists.
# Apply: core-sentinel-guardrail/supabase/document_scans.sql in Supabase SQL Editor.

# Optional (legacy / unused if you removed Gemini features)
GEMINI_API_KEY=
