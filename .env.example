# Copy to ".env" in this folder and fill in values (".env" is gitignored).

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Optional (preferred for retrain metadata writes):
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional override (defaults to retrain_runs):
GUARDRAIL_RETRAIN_SUPABASE_TABLE=retrain_runs

# Optional
GEMINI_API_KEY=
